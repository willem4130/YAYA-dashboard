# YAYA Atelier Environment Configuration
# Copy this file to .env.local and fill in your values

# App Configuration
NEXT_PUBLIC_APP_NAME="YAYA Atelier"
NEXT_PUBLIC_APP_URL="http://localhost:3004"

# n8n Integration Settings
N8N_BASE_URL="https://your-n8n-instance.com"
N8N_API_KEY="your-n8n-api-key"
N8N_WEBHOOK_BASE_URL="https://your-n8n-instance.com/webhook"

# YAYA Specific Configuration
YAYA_BRAND_MODE="production"
YAYA_CURRENT_SEASON="spring-2024"
YAYA_ATELIER_VERSION="1.0.0"

# Database Configuration (for workflow state persistence)
DATABASE_URL="postgresql://user:password@localhost:5432/yaya_atelier"

# File Storage Configuration
STORAGE_PROVIDER="local"
# For cloud storage, use: s3 | cloudflare-r2 | gcs
STORAGE_BUCKET="yaya-atelier-assets"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret"

# Authentication (if enabled)
NEXTAUTH_SECRET="your-auth-secret"
NEXTAUTH_URL="http://localhost:3004"
AUTH_PROVIDER="internal"
# Options: internal | oauth | saml

# External API Keys
OPENAI_API_KEY="your-openai-key"
ANTHROPIC_API_KEY="your-anthropic-key"

# Monitoring & Analytics
ANALYTICS_ENABLED="true"
NEXT_PUBLIC_GA_ID="G-..."
SENTRY_DSN="your-sentry-dsn"

# Email Service
RESEND_API_KEY="re_..."

# YAYA Brand Assets CDN
YAYA_ASSETS_CDN="https://assets.yaya.eu"